rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // รูปโปรไฟล์: เจ้าของอัปโหลดได้ ทุกคนอ่านได้
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // รูปหอพัก: ผู้ใช้ที่ล็อกอินแล้วอัปโหลดได้ ทุกคนอ่านได้
    match /dormitories/{dormId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // รูปห้องพัก: ทุกคนอ่านได้ ผู้ใช้ที่ล็อกอินแล้วอัปโหลดได้
    match /rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
